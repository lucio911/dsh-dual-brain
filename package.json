{
  "name": "dsh-dual-brain",
  "version": "1.0.0",
  "description": "Dual-Brain orchestrator: connects ChatGPT, Codex and reasoning models for planning, DSH for execution, and models for review.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dual-brain",
    "codex",
    "agent",
    "orchestration",
    "code-review"
  ],
  "license": "MIT",
  "author": "lucio911",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucio911/dsh-dual-brain.git"
  },
  "bugs": {
    "url": "https://github.com/lucio911/dsh-dual-brain/issues"
  },
  "homepage": "https://github.com/lucio911/dsh-dual-brain#readme",
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
